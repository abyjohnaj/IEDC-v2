# IEDC BMCE Environment Template
# Set to 'true' ONLY in local sandbox development. Must be 'false' for all builds.
VITE_ENABLE_DEMO=false
VITE_SUPABASE_URL=https://quxwzqcbuksxxgpprztw.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key_here

# Resend Email Integration (Configured in Supabase Edge Functions Secrets)
RESEND_API_KEY=re_your_api_key_here
